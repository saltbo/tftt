---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { listGeneratedArticles } from "../../lib/generatedArticles";

export const prerender = false;

const articles = (await listGeneratedArticles(Astro.locals.runtime.env.GENERATED_ARTICLES)).filter(
	(article) => article.status === "published",
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Topics | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
			}
			.topic-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.topic-list li {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 1.25rem 0;
			}
			.topic-list a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.topic-list a:hover {
				color: rgb(var(--accent));
			}
			.date {
				color: rgb(var(--gray));
				margin: 0.25rem 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Topics</h1>
			<ul class="topic-list">
				{
					articles.map((article) => (
						<li>
							<a href={`/topics/${article.slug}/`}>
								<h2>{article.title}</h2>
								<p class="date">
									Updated <FormattedDate date={new Date(article.updatedAt)} />
								</p>
								<p>{article.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
